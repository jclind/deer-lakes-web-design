---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.scss';
import { CallToAction } from '../../components/Layout/CallToAction';
import { MountainsHero } from '../../components/Common/MountainsHero';
import TopLocationsPage from '../../components/Pages/TopLocationsPage';
import { towns } from '../../assets/data/towns';
import { MONTHLY_SUM_PRICE } from '../../assets/data/pricing';

const { name, nearby } = towns.oakmont;
---

<Layout
  title={`Web Design in ${name}, PA`}
  description={`Hand-coded websites for ${name} small businesses. $0 down and $${MONTHLY_SUM_PRICE} a month, with hosting and edits included.`}
>
  <MountainsHero title={`Web design in ${name}`} />
  <TopLocationsPage locationName={name} nearby={nearby} />
  <CallToAction />
</Layout>
